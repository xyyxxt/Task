<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/lin1_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/lin1_2"
        android:orientation="vertical"
        android:gravity="center">
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/space_station_icon"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Space Stations" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lin1_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/lin1_1"
        app:layout_constraintEnd_toStartOf="@id/lin1_3"
        android:orientation="vertical"
        android:gravity="center">
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/rocket_icon" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flights" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lin1_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/lin1_2"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="vertical"
        android:gravity="center">
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/rover_icon" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rovers" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fra1"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lin1_2"
        android:layout_marginTop="20dp"
        android:paddingLeft="70dp"
        android:paddingRight="70dp">
        <TextView
            android:layout_width="125dp"
            android:layout_height="match_parent"
            android:background="#3E6B48"
            android:text="DCA"
            android:textColor="#FFFFFF"
            android:layout_gravity="left"
            android:gravity="center"
            />
        <TextView
            android:layout_width="125dp"
            android:layout_height="match_parent"
            android:background="#3E6B48"
            android:text="MARS"
            android:textColor="#FFFFFF"
            android:layout_gravity="right"
            android:gravity="center"/>
        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/double_arrows"
            android:layout_gravity="center"/>
    </FrameLayout>

    <TextView
        android:id="@+id/text3_1"
        android:layout_width="140dp"
        android:layout_height="30dp"
        android:text="One Way"
        app:layout_constraintTop_toBottomOf="@id/fra1"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginLeft="40dp"
        android:background="#F57C1F"
        android:textColor="#FFFFFF"
        android:gravity="center_vertical"
        android:layout_marginTop="15dp"/>

    <Switch
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="@id/text3_1"
        app:layout_constraintTop_toTopOf="@id/text3_1"
        app:layout_constraintEnd_toEndOf="@id/text3_1"/>

    <TextView
        android:id="@+id/text3_2"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        app:layout_constraintTop_toBottomOf="@id/text3_1"
        app:layout_constraintStart_toEndOf="@id/im3_3"
        android:background="#F57C1F"
        android:textColor="#FFFFFF"
        android:text="Traveller"
        android:layout_marginTop="15dp"

        android:gravity="center"/>

    <ImageView
        android:id="@+id/im3_3"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/arrow1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text3_1"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="40dp"
        android:rotation="270" />

    <ImageView
        android:id="@+id/im3_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/galaxy"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fra1"
        app:layout_constraintBottom_toTopOf="@id/text4_1"/>

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/rocket_icon"
        app:layout_constraintBottom_toTopOf="@id/text4_1"
        app:layout_constraintTop_toBottomOf="@id/fra1"
        app:layout_constraintEnd_toStartOf="@id/im3_2"
        android:layout_marginEnd="24dp"/>

    <TextView
        android:id="@+id/text4_1"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:text="DEPART"
        android:textColor="#FFFFFF"
        android:background="#3E6B48"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="10dp"
        android:layout_marginHorizontal="5dp"/>


</androidx.constraintlayout.widget.ConstraintLayout>